# Gemini API key (used by Vite to inject into process.env.API_KEY and process.env.GEMINI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter API key (used when selecting OpenRouter models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional/legacy: direct API_KEY fallback (kept for compatibility with docs)
API_KEY=your_gemini_api_key_here
